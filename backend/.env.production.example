APP_NAME="Market Order System API"
APP_ENV=production
DATABASE_URL=sqlite:///./market_order_system.sqlite3
CORS_ORIGINS=https://market-domaininiz.com
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Production'da varsayilan admin/employee seed sifreleri kullanilmaz.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_USERNAME=
SEED_EMPLOYEE_PASSWORD=

UPLOAD_DIRECTORY=uploads
MAX_PRODUCT_IMAGE_BYTES=2097152
MAX_BACKUP_UPLOAD_BYTES=52428800

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
