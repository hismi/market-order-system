APP_NAME="Market Order System API"
APP_ENV=development
DATABASE_URL=sqlite:///./market_order_system.sqlite3
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5502,http://localhost:5502,http://127.0.0.1:8000
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD=
UPLOAD_DIRECTORY=uploads
MAX_PRODUCT_IMAGE_BYTES=2097152
MAX_BACKUP_UPLOAD_BYTES=52428800
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
